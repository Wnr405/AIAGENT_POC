{
  "name": "cms-api",
  "version": "1.0.0",
  "private": true,
  "description": "CMS MVP backend — NestJS shell around a hexagonal core (04-ARCH §4)",
  "engines": {
    "node": ">=20.11 <23"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:memory": "cross-env PERSISTENCE=memory tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:changed": "stryker run --incremental",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "dup": "jscpd src --config .jscpd.json",
    "openapi:generate": "tsx src/openapi/generate.ts openapi.json",
    "openapi:check": "tsx src/openapi/generate.ts openapi.json --check",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.42.0",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nestjs/testing": "^10.4.15",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@swc/core": "^1.10.1",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.16.0",
    "eslint-plugin-sonarjs": "^3.0.1",
    "jscpd": "^4.0.5",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
