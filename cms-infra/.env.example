# ============================================================================
# CMS — Environment Configuration (07-OPS-ARCH §7.2 canonical schema)
# Copy to /opt/cms/shared/env/.env.production (mode 0600). Do NOT commit .env.
# Generate secrets with ./scripts/gen-secrets.sh
# Validated at startup by cms-api/src/config/env.schema.ts — keep both in sync
# (CI job `env-schema-sync` fails if a key exists in one but not the other).
# ============================================================================

# ─── Deployment metadata ────────────────────────────────────────────────────
NODE_ENV=production                          # production | staging | development
APP_VERSION=1.0.0                            # image tag deployed
APP_NAME=CMS
CMS_API_IMAGE=ghcr.io/org/cms-api:1.0.0

# ─── Public URLs ────────────────────────────────────────────────────────────
PUBLIC_URL=https://cms.example.com
API_PUBLIC_URL=https://cms.example.com/api
CORS_ALLOWED_ORIGINS=https://www.example.com
SERVER_NAME=cms.example.com

# ─── HTTP server ────────────────────────────────────────────────────────────
HTTP_PORT=3000
HTTP_BODY_LIMIT_MB=25
TRUST_PROXY=true

# ─── Database (Postgres) ────────────────────────────────────────────────────
PERSISTENCE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cms                            # schema owner — migrations only
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=cms
POSTGRES_APP_USER=cms_app                    # runtime role: no UPDATE/DELETE on audit_events
POSTGRES_APP_PASSWORD=__CHANGE_ME__
# Written out in full: env_file values are not interpolated on every Compose version.
DATABASE_URL=postgresql://cms_app:__CHANGE_ME__@postgres:5432/cms?schema=public&connection_limit=10
MIGRATION_DATABASE_URL=postgresql://cms:__CHANGE_ME__@postgres:5432/cms?schema=public

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__CHANGE_ME__
REDIS_URL=redis://default:__CHANGE_ME__@redis:6379

# ─── Object storage (S3 or MinIO) ───────────────────────────────────────────
OBJECT_STORAGE_PROVIDER=minio                # minio | s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000    # internal endpoint used by the API
OBJECT_STORAGE_PRESIGN_ENDPOINT=https://media.cms.example.com   # browser-reachable, for presigned PUTs
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cms-media
OBJECT_STORAGE_ACCESS_KEY=__CHANGE_ME__
OBJECT_STORAGE_SECRET_KEY=__CHANGE_ME__
OBJECT_STORAGE_PUBLIC_URL=                   # set when a CDN fronts the bucket; empty → signed URLs (SEC-06)

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=__CHANGE_ME_64_CHAR_HEX__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
ARGON2_MEMORY_KB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# ─── Rate limiting (SEC-07) ─────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_PUBLIC_API_PER_MIN=60
RATE_LIMIT_ADMIN_MUTATION_PER_MIN=60

# ─── Email ──────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=ses                           # ses | smtp | console (dev only)
EMAIL_FROM=no-reply@cms.example.com
EMAIL_FROM_NAME=CMS
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_SECURE=false                            # STARTTLS on 587

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cms-api

# ─── Worker ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_SCHEDULED_PUBLISH_INTERVAL_SEC=30

# ─── Feature flags ──────────────────────────────────────────────────────────
FEATURE_MEDIA_VARIANTS_ENABLED=true
FEATURE_SCHEDULED_PUBLISH_ENABLED=true

# ─── Content / media ────────────────────────────────────────────────────────
MEDIA_MAX_UPLOAD_MB=20
CONTENT_CATEGORIES=News,Reports,Guides,Announcements
SOFT_DELETE_RETENTION_DAYS=30

# ─── First admin (created as an invite when the users table is empty) ───────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator

# ─── Backup ─────────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=cms-backups-offsite
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=__CHANGE_ME__
BACKUP_S3_SECRET_KEY=__CHANGE_ME__
BACKUP_RETENTION_HOURLY=24
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
RESTIC_PASSWORD=__CHANGE_ME__

# ─── MinIO root (only if using MinIO) ───────────────────────────────────────
MINIO_ROOT_USER=__CHANGE_ME__
MINIO_ROOT_PASSWORD=__CHANGE_ME_32_CHARS__

# ─── Smoke tests ────────────────────────────────────────────────────────────
SMOKE_API_KEY=__CHANGE_ME__                  # a read-only key created for monitoring
